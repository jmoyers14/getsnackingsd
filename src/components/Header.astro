---
import { site, navLinks } from '../lib/site';
---

<header
  class="sticky top-0 z-50 border-b border-line bg-surface-0/95 backdrop-blur"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" class="flex items-baseline gap-3">
      <span class="font-display text-lg tracking-wide text-ink-900">
        {site.name}
      </span>
      <span
        class="hidden text-[0.625rem] uppercase tracking-[0.22em] text-ink-500 sm:inline"
      >
        {site.descriptor}
      </span>
    </a>

    {
      (navLinks.length > 0 || site.showContactInfo) && (
        <nav class="flex items-center gap-6" aria-label="Main">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="hidden text-sm text-ink-900 underline-offset-4 hover:underline sm:block"
            >
              {link.label}
            </a>
          ))}
          {site.showContactInfo && (
            <a
              href={site.ctaHref}
              class="rounded-md bg-ink-900 px-4 py-2 text-sm font-medium tracking-wide text-surface-0 transition-opacity hover:opacity-85"
            >
              {site.ctaLabel}
            </a>
          )}
        </nav>
      )
    }
  </div>
</header>
