---
import { site, navLinks } from '../lib/site';
---

<header
  class="sticky top-0 z-50 border-b border-line bg-surface-0/90 backdrop-blur"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a
      href="/"
      class="font-display text-lg font-bold tracking-tight text-ink-900"
    >
      {site.name}
    </a>

    <nav class="flex items-center gap-6" aria-label="Main">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="hidden text-sm text-ink-700 transition-colors hover:text-brand-700 sm:block"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={site.ctaHref}
        class="rounded-md bg-accent-500 px-4 py-2 text-sm font-semibold text-ink-900 transition-colors hover:bg-accent-600"
      >
        {site.ctaLabel}
      </a>
    </nav>
  </div>
</header>
