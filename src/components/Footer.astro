---
import { site, phoneHref, phoneDisplay } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface-50">
  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <p class="font-display text-base font-bold text-ink-900">{site.name}</p>
        <p class="mt-2 text-sm text-ink-500">{site.tagline}</p>
      </div>

      <div class="text-sm">
        <h2 class="font-semibold text-ink-900">Get in touch</h2>
        <ul class="mt-2 space-y-1">
          <li>
            <a href={phoneHref} class="text-ink-700 hover:text-brand-700">
              {phoneDisplay}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${site.email}`}
              class="text-ink-700 hover:text-brand-700"
            >
              {site.email}
            </a>
          </li>
        </ul>
      </div>

      <div class="max-w-xs text-sm">
        <h2 class="font-semibold text-ink-900">Service area</h2>
        <p class="mt-2 text-ink-500">{site.areaServed.join(' · ')}</p>
      </div>
    </div>

    <p class="mt-10 border-t border-line pt-6 text-xs text-ink-500">
      © {year} {site.name}. Serving {site.region}.
    </p>
  </div>
</footer>
