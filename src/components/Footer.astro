---
import { site, phoneHref, phoneDisplay } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface-50">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <!-- The card's lockup: wordmark, rule, tracked descriptor. -->
      <div class="max-w-sm">
        <p class="font-display text-xl tracking-wide text-ink-900">
          {site.name}
        </p>
        <hr class="mt-3 border-t border-line" />
        <p class="mt-3 text-xs uppercase tracking-[0.22em] text-ink-500">
          {site.descriptor}
        </p>
      </div>

      <div class="text-sm">
        <h2 class="text-xs uppercase tracking-[0.18em] text-ink-500">
          Get in touch
        </h2>
        <ul class="mt-3 space-y-2">
          <li>
            <a
              href={phoneHref}
              class="text-ink-900 underline-offset-4 hover:underline"
            >
              {phoneDisplay}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${site.email}`}
              class="text-ink-900 underline-offset-4 hover:underline"
            >
              {site.email}
            </a>
          </li>
        </ul>
      </div>

      <div class="max-w-xs text-sm">
        <h2 class="text-xs uppercase tracking-[0.18em] text-ink-500">
          Service area
        </h2>
        <p class="mt-3 text-ink-900">{site.areaServed.join(' · ')}</p>
      </div>
    </div>

    <p class="mt-12 border-t border-line-soft pt-6 text-xs text-ink-500">
      © {year} {site.name}. Serving {site.region}.
    </p>
  </div>
</footer>
