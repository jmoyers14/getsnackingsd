---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  titleExact?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Matches --color-surface-0 exactly: mobile browser chrome sits flush
         against the page instead of a near-miss cream. -->
    <meta name="theme-color" content="#fffdf5" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {...Astro.props} />
    <slot name="head" />
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-surface-0 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-ink-900 focus:shadow-lg"
    >
      Skip to content
    </a>

    <Header />

    <!-- flex column so a short page's content can centre itself with
         my-auto instead of hugging the top and leaving a gap above the footer -->
    <main id="main" class="flex flex-1 flex-col">
      <slot />
    </main>

    <Footer />
  </body>
</html>
