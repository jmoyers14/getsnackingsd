---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
---

<Layout title={`${site.name} — ${site.descriptor}`} titleExact>
  <section class="mx-auto max-w-6xl px-5 py-24">
    <p class="text-xs uppercase tracking-[0.22em] text-ink-500">
      {site.region}
    </p>
    <h1 class="mt-5 max-w-3xl text-4xl sm:text-5xl">
      {site.tagline}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-ink-900">
      {site.description}
    </p>
    <a
      href={site.ctaHref}
      class="mt-10 inline-block rounded-md bg-ink-900 px-6 py-3 font-medium tracking-wide text-surface-0 transition-opacity hover:opacity-85"
    >
      {site.ctaLabel}
    </a>
  </section>

  <section id="contact" class="mx-auto max-w-6xl px-5 pb-24">
    <div class="rounded-xl border border-line bg-surface-50 p-8">
      <h2 class="text-2xl">Contact form goes here</h2>
      <p class="mt-2 text-ink-500">Placeholder — built in card 4.</p>
    </div>
  </section>
</Layout>
